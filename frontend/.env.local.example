# FastAPI 백엔드 베이스 URL (끝에 /api/v1 까지 포함)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# 디버그 모드 (true = 콘솔에 요청/응답 로그 출력)
NEXT_PUBLIC_API_DEBUG=true

# 네이버 OAuth 클라이언트 ID (공개값 — 네이버 개발자센터에서 확인)
NEXT_PUBLIC_NAVER_CLIENT_ID=여기에_네이버_CLIENT_ID_입력

# 네이버 개발자센터에 등록한 콜백 URL과 반드시 일치해야 함
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/login
